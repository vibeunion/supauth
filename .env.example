# SupaOAuth Admin Console — browser-side only
# Do NOT put management tokens or service-role keys in VITE_* variables.
VITE_AUTH_SERVER_URL=/api

# SupaOAuth Auth Server — server-side only (never VITE_*)
PORT=4000
HOST=0.0.0.0
SUPACLOUD_API_URL=http://localhost:9090
SUPACLOUD_MASTER_TOKEN=
PROJECT_REF=
OAUTH_RUNTIME_URL=http://localhost:9999
RUNTIME_MODE=gotrue
DATABASE_URL=postgres://supaoauth:password@localhost:5432/supabase
CORS_ORIGINS=http://localhost:5173,http://localhost:4000
LOG_LEVEL=info
ADMIN_TOKEN=
