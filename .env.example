# SupaOAuth Admin Console — browser-side only
# Do NOT put management tokens or service-role keys in VITE_* variables.
VITE_AUTH_SERVER_URL=/api

# SupAuth SupaCloud Function — server-side only (never VITE_*)
# In a real SupaCloud project these values are injected by SupaCloud.
# Local development may provide them manually for the Function emulator.
PORT=4010
HOST=0.0.0.0
SUPACLOUD_INTERNAL_API_URL=
SUPACLOUD_INTERNAL_TOKEN=
# Independent 32+ character HMAC secret shared with SupaCloud Management API.
# Server-side only; never expose to the browser or reuse a token/encryption key.
SUPAOAUTH_BFF_SIGNING_SECRET=
SUPACLOUD_PROJECT_REF=
SUPACLOUD_RUNTIME_URL=
SUPACLOUD_RUNTIME_INTERNAL_URL=
# Public browser-facing SupAuth/Auth origin. Required in production.
SUPAUTH_PUBLIC_URL=http://localhost:4010
# Optional dedicated SupAuth API origin. When set, the installer creates a
# separate API/OAuth gateway route without taking over the GoTrue /auth/v1 path.
SUPAUTH_API_URL=
# Optional default domain for generated account provisioning emails.
SUPAUTH_ACCOUNT_PROVISIONING_EMAIL_DOMAIN=example.com
# Only enable when your reverse proxy sanitizes and owns X-Forwarded-* headers.
TRUST_PROXY_HEADERS=0
RUNTIME_MODE=gotrue
SUPACLOUD_DATABASE_URL=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
ADMIN_TOKEN=

# Admin SSO server metadata. Production installation requires an explicit HTTPS issuer and client id.
ADMIN_SSO_ISSUER=
ADMIN_SSO_CLIENT_ID=
# Optional public metadata; redirect URIs are derived from SUPAUTH_PUBLIC_URL when omitted.
ADMIN_SSO_JWKS_URI=
ADMIN_SSO_AUDIENCE=
ADMIN_SSO_REDIRECT_URI=
ADMIN_SSO_POST_LOGOUT_REDIRECT_URI=
# Disabled by default. Set to true to require an aal2 token after the
# usual JWT/OIDC and exact-email allowlist checks; this is never a VITE_* value.
ADMIN_SSO_REQUIRE_AAL2=false
# Optional server-only fallback. A non-empty DB allowlist takes priority; never expose these as VITE_*.
ADMIN_SSO_ALLOWED_EMAILS=
ADMIN_SSO_ALLOWED_DOMAINS=

# Optional P0-9 live OAuth 2.1 compatibility fixture.
# Leave disabled for normal local tests. Do not commit real token values.
RUN_SUPABASE_RUNTIME_COMPAT=0
RUN_SUPABASE_OAUTH21_COMPAT=0
OAUTH21_CLIENT_ID=
OAUTH21_REDIRECT_URI=http://localhost:3000/oauth/callback
OAUTH21_ACCESS_TOKEN=
OAUTH21_REFRESH_TOKEN=
OAUTH21_TOKEN_AUTH_METHOD=none
OAUTH21_CLIENT_SECRET=
