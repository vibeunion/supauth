+import type { Filter, Sort, CrudOperator } from "./supauth-types-types.js";
+/**
+ * Get the current filter value for a field from a filter array.
+ */
+export declare function getDefaultFilter(columnName: string, filters?: Filter[], operatorType?: CrudOperator): unknown | undefined;
+/**
+ * Get the current sort order for a field from a sorter array.
+ */
+export declare function getDefaultSortOrder(columnName: string, sorters?: Sort[]): 'asc' | 'desc' | undefined;
+/**
+ * Merge two filter arrays, deduplicating by field+operator.
+ */
+export declare function unionFilters(permanentFilter: Filter[], newFilters: Filter[], prevFilters?: Filter[]): Filter[];
+/**
+ * Merge two sorter arrays, deduplicating by field.
+ */
+export declare function unionSorters(permanentSorters: Sort[], newSorters: Sort[]): Sort[];
+/**
+ * Convert a File to a base64 data URL string.
+ */
+export declare function file2Base64(file: File | {
+    uid?: string;
+} & Blob): Promise<string>;
+/** Parse full CSV text respecting quoted multi-line fields */
+export declare function parseCSV(text: string): string[][];
+/**
+ * TypeBox validator interface matching TypeCompiler.Compile or Value.Errors
+ */
+export type TypeBoxValidatorLike = {
+    Check?: (value: unknown) => boolean;
+    Errors: (value: unknown) => Iterable<{
+        path?: string;
+        message: string;
+    }>;
+};
+/**
+ * Creates a synchronous form validator function specifically optimized for TypeBox
+ * compiled validators (from TypeCompiler.Compile) or TypeBox value checks.
+ *
+ * @example
+ * ```ts
+ * import { Type } from '@sinclair/typebox';
+ * import { TypeCompiler } from '@sinclair/typebox/compiler';
+ * import { createTypeBoxValidator, useForm } from '@svadmin/core';
+ *
+ * const userSchema = Type.Object({
+ *   name: Type.String({ minLength: 2 }),
+ *   email: Type.String({ format: 'email' }),
+ * });
+ *
+ * const compiledUser = TypeCompiler.Compile(userSchema);
+ *
+ * const form = useForm({
+ *   resource: 'users',
+ *   validate: createTypeBoxValidator(compiledUser),
+ * });
+ * ```
+ */
+export declare function createTypeBoxValidator(validator: TypeBoxValidatorLike): (values: Record<string, unknown>) => Record<string, string> | null;
