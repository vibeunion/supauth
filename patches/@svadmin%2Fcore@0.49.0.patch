+export type FilterSetMode = 'merge' | 'replace';
+export interface TableStateOptions<TData extends BaseRecord = BaseRecord, TError = HttpError> extends Omit<UseListOptions<TData, TError>, 'pagination' | 'sorters' | 'filters'> {
+    resource?: KnownResources;
+    pagination?: Pagination;
+    sorters?: {
+        initial?: Sort[];
+        permanent?: Sort[];
+        mode?: 'off' | 'server';
+    };
+    filters?: {
+        initial?: Filter[];
+        permanent?: Filter[];
+        mode?: 'off' | 'server';
+        defaultBehavior?: FilterSetMode;
+    };
+    syncWithLocation?: boolean;
+}
+/**
+ * Svelte 5 Class-based reactive table state.
+ *
+ * Usage:
+ * ```ts
+ * const table = new TableState({ resource: 'posts' });
+ * table.setPage(2);
+ * table.toggleSort('title');
+ * console.log(table.data); // reactive
+ * ```
+ */
+export declare class TableState<TData extends BaseRecord = BaseRecord, TError = HttpError> {
+    pagination: Pagination;
+    currentSorters: Sort[];
+    currentFilters: Filter[];
+    private permanentSorters;
+    private permanentFilters;
+    private sortersMode;
+    private filtersMode;
+    private filterDefaultBehavior;
+    private syncWithLocation;
+    private paginationMode;
+    private adminContext;
+    private _queryResult;
+    constructor(options?: TableStateOptions<TData, TError>);
+    get effectiveSorters(): Sort[];
+    get effectiveFilters(): Filter[];
+    private get queryPagination();
+    /** Underlying TanStack Query result */
+    get query(): import("@tanstack/svelte-query").CreateQueryResult<GetListResult<TData>, TError> & {
+        overtime: import("./supauth-types-hook-utils.svelte.js").OvertimeResult;
+    };
+    /** Table data rows */
+    get data(): TData[];
+    /** Total record count */
+    get total(): number;
+    /** Is data loading */
+    get isLoading(): boolean;
+    /** Is data error */
+    get isError(): boolean;
+    /** Error object */
+    get error(): TError | null;
+    /** Current page number */
+    get current(): number;
+    /** Page size */
+    get pageSize(): number;
+    /** Total number of pages */
+    get pageCount(): number;
+    /** Has next page */
+    get hasNextPage(): boolean;
+    /** Has previous page */
+    get hasPreviousPage(): boolean;
+    setPage(page: number): void;
+    setPageSize(size: number): void;
+    nextPage(): void;
+    previousPage(): void;
+    setSorters(newSorters: Sort[]): void;
+    toggleSort(field: string): void;
+    setFilters(newFilters: Filter[], mode?: FilterSetMode): void;
+    resetFilters(): void;
+    get clientData(): TData[];
+}
