+        errored: {
+            request: unknown;
+            error: unknown;
+        }[];
+    }) => void;
+    onProgress?: (info: {
+        totalAmount: number;
+        processedAmount: number;
+    }) => void;
+    meta?: Record<string, unknown>;
+    dataProviderName?: string;
+}
+/**
