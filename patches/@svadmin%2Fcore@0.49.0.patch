+export interface UseExportOptions<TData extends BaseRecord = BaseRecord> {
+    resource?: string;
+    mapData?: (item: TData) => Record<string, unknown>;
+    sorters?: Sort[];
+    filters?: Filter[];
+    maxItemCount?: number;
+    pageSize?: number;
+    download?: boolean;
