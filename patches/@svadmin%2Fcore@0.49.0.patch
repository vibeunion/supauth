+ */
+export declare function useImport<TData = Record<string, unknown>>(options?: UseImportOptions<TData>): {
+    inputProps: {
+        type: "file";
+        accept: string;
+    };
+    handleChange: (info: {
+        file: File;
+    }) => Promise<void>;
+    readonly isLoading: boolean;
+    readonly mutationResult: {
+        succeeded: unknown[];
+        errored: {
+            request: unknown;
+            error: unknown;
+        }[];
+    } | null;
+};
