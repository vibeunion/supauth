+export declare function provideAdminContext(source: AdminContextSource): AdminContextValue;
+/** Return the current tree context when called during component initialization/render. */
+export declare function getAdminContext(): AdminContextValue | undefined;
+/** Capture the current tree once so delayed callbacks never re-enter getContext. */
+export declare function captureAdminContext(): AdminContextAccessor;
+export declare function setDataProvider(provider: DataProviderInput): void;
