+export declare function getAuthProvider(options: {
+    optional: true;
+}): AuthProvider | null;
+export declare function setResources(newResources: ResourceDefinition[]): void;
+export declare function getResources(): ResourceDefinition[];
+export declare function getResource(nameOrIdentifier: string): ResourceDefinition;
+export declare function setRouterProvider(provider: RouterProvider | undefined): void;
+export declare function getRouterProvider(): RouterProvider | undefined;
+export declare function setLiveProvider(provider: LiveProvider): void;
+export declare function getLiveProvider(): LiveProvider | undefined;
+export declare function setTaskProvider(provider: TaskProvider | undefined): void;
