{
  "name": "@supauth/admin-console",
  "version": "0.8.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "bun run typecheck:tooling && bun test --isolate src scripts",
    "preview": "vite preview",
    "check": "bun run typecheck:tooling && svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./jsconfig.json",
    "typecheck": "bun run typecheck:tooling && svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./jsconfig.json --threshold error",
    "typecheck:tooling": "tsc --project ./tsconfig.config.json --noEmit && tsc --project ./scripts/tsconfig.json --noEmit && tsc --project ./tsconfig.bun.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.113.0",
    "@supacloud/contracts": "0.3.1",
    "@supabase/auth-js": "^2.113.0",
    "@supauth/shared": "workspace:*",
    "@svadmin/core": "^0.56.0",
    "@svadmin/sso": "^0.13.0",
    "@svadmin/sveltekit": "^0.12.0",
    "@svadmin/ui": "^0.76.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-query": "^6.1.48",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@types/node": "^26.4.1",
    "@types/papaparse": "^5.5.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "@types/bun": "^1.4.0",
    "bun-types": "1.4.0"
  }
}
