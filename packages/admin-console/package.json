{
  "name": "@supauth/admin-console",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "bun run typecheck:tooling && bun test --isolate src scripts",
    "preview": "vite preview",
    "check": "bun run typecheck:tooling && svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./jsconfig.json",
    "typecheck": "bun run typecheck:tooling && svelte-kit sync && svelte-check --tsgo-experimental-api --tsconfig ./jsconfig.json --threshold error",
    "typecheck:tooling": "tsc --project ./tsconfig.config.json --noEmit && tsc --project ./scripts/tsconfig.json --noEmit && tsc --project ./tsconfig.bun.json --noEmit"
  },
  "dependencies": {
    "@supabase/auth-js": "2.118.0",
    "@supabase/supabase-js": "^2.118.0",
    "@supacloud/contracts": "0.15.2",
    "@supauth/shared": "workspace:*",
    "@svadmin/core": "^0.71.0",
    "@svadmin/sso": "^0.13.22",
    "@svadmin/sveltekit": "^0.13.19",
    "@svadmin/ui": "^0.110.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/svelte-query": "^6.3.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "bun-types": "1.4.4",
    "csstype": "3.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.5"
  }
}
